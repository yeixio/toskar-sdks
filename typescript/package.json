{
  "name": "toskar",
  "version": "0.2.0",
  "description": "The official TypeScript and JavaScript SDK for Toskar: local AI across your computers.",
  "keywords": [
    "toskar",
    "ai",
    "llm",
    "local-ai",
    "sdk"
  ],
  "license": "Apache-2.0",
  "homepage": "https://toskar.ai/developers",
  "bugs": {
    "url": "https://github.com/yeixio/toskar-sdks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeixio/toskar-sdks.git",
    "directory": "typescript"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "generate": "openapi-typescript ../spec/openapi.sdk.json -o src/generated/api.ts && node scripts/codes.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "reference": "typedoc"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "undici": "6.29.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "openapi-typescript": "7.13.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "optionalDependencies": {
    "bonjour-service": "1.4.4"
  }
}
