{
  "name": "toskar",
  "version": "0.1.0",
  "description": "The official TypeScript and JavaScript SDK for Toskar: local AI across your computers.",
  "license": "Apache-2.0",
  "homepage": "https://toskar.ai/developers",
  "repository": { "type": "git", "url": "git+https://github.com/yeixio/toskar-sdks.git", "directory": "typescript" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "scripts": {
    "generate": "openapi-typescript ../spec/openapi.sdk.json -o src/generated/api.ts && node scripts/codes.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
